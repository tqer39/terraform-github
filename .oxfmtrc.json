{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "ignorePatterns": [
    "**/node_modules/**",
    "**/.terraform/**",
    "**/modules.json",
    ".claude/worktrees/**",
    ".pnpm-store/**"
  ],
  "sortPackageJson": false,
  "trailingComma": "none"
}
